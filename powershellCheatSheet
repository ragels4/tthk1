# ============================================
# PowerShell Cheat Sheet — Basic File Commands
# ============================================

# Creates folder on Desktop
New-Item -Path "C:\Users\$env:USERNAME\Desktop\MyFolder" -ItemType Directory

# Creates text file inside that folder
New-Item -Path "C:\Users\$env:USERNAME\Desktop\MyFolder\myfile.txt" -ItemType File

# Writes text into the file (overwrites existing text)
Set-Content -Path "C:\Users\$env:USERNAME\Desktop\MyFolder\myfile.txt" -Value "Hello, World!"

# Adds text to the file (without removing old text)
Add-Content -Path "C:\Users\$env:USERNAME\Desktop\MyFolder\myfile.txt" -Value "Another line"

# Moves the text file to the new folder
Move-Item -Path "C:\Users\$env:USERNAME\Desktop\MyFolder\myfile.txt" -Destination "C:\Users\$env:USERNAME\Desktop\NewFolder"

